# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
# Production : https://francemobilier.org
SUPPORT_EMAIL=contact@francemobilier.org

# SQLite local (Railway uses file:/app/data/maisonora.db)
DATABASE_URL=file:./data/maisonora.db

# Compte autorisé à valider les avis (virgules si plusieurs). hugo.rusu@gmail.com a aussi accès admin.
ADMIN_EMAIL=contact@francemobilier.org

# Store flags
STORE_CHECKOUT_ENABLED=false
NEXT_PUBLIC_STORE_CHECKOUT_ENABLED=false
MERCHANT_LAUNCH_MODE=true
GOOGLE_MERCHANT_FEED_ENABLED=false

# Identité Merchant (ne pas inventer)
BUSINESS_STREET_ADDRESS=
BUSINESS_PHONE=
RETURN_SHIPPING_PAID_BY=
RETURN_ADDRESS=

# Délais Merchant (jours ouvrés). Défaut : préparation 5 (1 semaine), acheminement 7.
HANDLING_MIN_BUSINESS_DAYS=5
HANDLING_MAX_BUSINESS_DAYS=5
TRANSIT_MIN_BUSINESS_DAYS=7
TRANSIT_MAX_BUSINESS_DAYS=7

# Stripe — les clés sk_test_ / pk_test_ ouvrent le checkout en test.
# Le live (sk_live_) reste fermé tant que STORE_CHECKOUT_ENABLED n’est pas true.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Confirmation de commande (Resend et/ou SMTP). Stripe test n’envoie pas d’e-mail.
# Suivi auto : e-mail fin de préparation puis expédition (jours ouvrés ci-dessus).
# L’envoi part tout seul toutes les 15 min. CRON_SECRET sert seulement à /api/cron/order-lifecycle.
CRON_SECRET=
RESEND_API_KEY=
MAIL_FROM=France Mobilier <contact@francemobilier.org>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# BuckyDrop OpenAPI (do not invent endpoints)
BUCKYDROP_ENABLED=false
BUCKYDROP_ENV=sandbox
BUCKYDROP_APP_CODE=
BUCKYDROP_APP_SECRET=
BUCKYDROP_API_BASE_URL=

# Espace Pro (optionnel). Sans PRO_SALES_EMAIL, les demandes vont à MAIL_FROM / support.
PRO_SALES_EMAIL=
B2B_QUOTE_THRESHOLD=1000


# Google Ads Keyword Planner (admin /admin/mots-cles)
# Jeton : https://ads.google.com/aw/apicenter
# OAuth local : npm run ads:oauth
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v23
